<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_view_from_inherit_l10n_vn_edi_mini_custom" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_vn_edi.mini_custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_vn_edi_viettel.res_partner_view_from_inherit_l10n_vn_edi"/>
        <field name="arch" type="xml">
            <field name="l10n_vn_edi_symbol" position="after">
                <field name="einvoice_name_vn" invisible="is_company"/>
            </field>
        </field>
    </record>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting_disabled']" position="inside">
                <group>
                    <field name="einvoice_name_vn"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

