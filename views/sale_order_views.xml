<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_l10n_vn_edi_mini_custom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.l10n_vn_edi.mini_custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="sinvoice_payment_method"
                       options="{'no_open': True, 'no_create': True}"
                       invisible="country_code != 'VN'"/>
            </xpath>
        </field>
    </record>
</odoo>
